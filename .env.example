# Database (Neon Postgres, via Drizzle ORM)
DATABASE_URL=

# Session auth
SESSION_SECRET=
WORK_HUB_PASSCODE_HASH=

# Cron endpoint protection (GitHub Actions -> /api/cron/*)
CRON_SECRET=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY, exposed under the NEXT_PUBLIC_ prefix so
# browser-side code (EnableNotificationsButton) can read it for
# pushManager.subscribe({ applicationServerKey }). Public key only — never
# mirror VAPID_PRIVATE_KEY this way.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Identifies the sender to push services per the Web Push protocol (the
# `sub` claim) — must be a real `mailto:you@example.com` address or an
# `https://` URL Callum controls, NOT a placeholder. Push services (Apple in
# particular) may use this to contact the sender about delivery problems;
# lib/push/send.ts fails loudly if this is unset rather than silently using
# a fake address.
VAPID_SUBJECT=

# Frame.io OAuth (Adobe Developer Console)
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
FRAMEIO_PROJECT_ID=

# Frame.io V4 API polling (GET /v4/accounts/{FRAMEIO_ACCOUNT_ID}/...)
FRAMEIO_ACCOUNT_ID=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram capture bot (voice/text -> to-dos and content ideas)
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Any long random string (e.g. `openssl rand -hex 32`), set once via the
# `setWebhook` call's `secret_token` — Telegram echoes it back on every
# webhook call as `X-Telegram-Bot-Api-Secret-Token`, checked in
# lib/telegram/webhook-auth.ts the same way CRON_SECRET gates /api/cron/*.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram chat ids (Callum's own, plus anyone
# else added) — the only chats the webhook will act on; a message from
# any other chat is fully ignored.
TELEGRAM_ALLOWED_CHAT_IDS=

# Groq (voice transcription + structured message parsing for the
# Telegram capture bot) — free API key from console.groq.com, no card
# needed
GROQ_API_KEY=

# Posting-schedule Google Sheet — the sheet's own CSV export URL (it's
# shared "anyone with the link can view", so this needs no Google OAuth).
# In the sheet, File > Share > get the link, then build:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<TAB_GID>
POSTING_SCHEDULE_SHEET_CSV_URL=
